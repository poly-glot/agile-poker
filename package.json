{
  "name": "agile-poker",
  "version": "1.0.2",
  "description": "",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --project demo-agile-poker --only auth,database,hosting \"vitest run\"",
    "test:watch": "firebase emulators:exec --project demo-agile-poker --only auth,database,hosting \"vitest\"",
    "test:snapshot": "firebase emulators:exec --project demo-agile-poker --only auth,database,hosting \"vitest run --update\"",
    "test:coverage": "firebase emulators:exec --project demo-agile-poker --only auth,database,hosting \"vitest run --coverage\"",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "percy": "percy exec -- npm run cy:run",
    "start": "firebase emulators:exec --project demo-agile-poker \"vite --mode development\"",
    "serve": "firebase emulators:start --project demo-agile-poker",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint src/ --fix",
    "lint:css": "stylelint --fix src/**/*.css",
    "precommit": "lint-staged"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "firebase": "^11.3.0",
    "focus-visible": "^5.2.0",
    "lodash.debounce": "^4.0.8",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@percy/cli": "^1.30.0",
    "@percy/cypress": "^3.1.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "cypress": "^13.17.0",
    "cypress-file-upload": "^5.0.8",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0",
    "firebase-functions-test": "^3.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.3.0",
    "postcss": "^8.4.49",
    "postcss-preset-env": "^10.1.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "serve": "^14.2.4",
    "sonarqube-scanner": "^4.2.4",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 safari versions"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit",
      "pre-push": "npm test"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "side-effects": false
}
